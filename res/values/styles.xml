<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">#0A0C10</item>
        <item name="android:navigationBarColor">#0A0C10</item>
    </style>

    <style name="ShadcnSwitch">
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:switchMinWidth">48dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <item name="android:showText">false</item>
        <item name="android:textOn"></item>
        <item name="android:textOff"></item>
        <item name="android:splitTrack">false</item>
    </style>
</resources>
