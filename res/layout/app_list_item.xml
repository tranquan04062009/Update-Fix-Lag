<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_bento">

    <!-- App Icon & Avatar Container -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/app_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_pill_active"
            android:textColor="#00F0FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="A" />
    </FrameLayout>

    <!-- App Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tên ứng dụng" />

        <TextView
            android:id="@+id/app_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:text="com.example.app" />
    </LinearLayout>

    <!-- Hibernate Action Button -->
    <TextView
        android:id="@+id/btn_hibernate"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_btn_secondary"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="6dp"
        android:text="Ngủ đông" />

    <!-- Whitelist Lock/Protect Toggle Button -->
    <TextView
        android:id="@+id/btn_whitelist"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_btn_secondary"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Khóa" />

</LinearLayout>
