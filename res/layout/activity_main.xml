<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C10">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#0A0C10">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z-RAM Purger"
                android:textColor="#F3F5F9"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tối ưu bộ nhớ &amp; hiệu năng"
                android:textColor="#6B7385"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_header_privilege"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_badge_shizuku"
            android:text="SHIZUKU"
            android:textColor="#2DD4B0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar">

        <include
            android:id="@+id/tab_dashboard_view"
            layout="@layout/tab_dashboard"
            android:visibility="visible" />

        <include
            android:id="@+id/tab_apps_view"
            layout="@layout/tab_apps"
            android:visibility="gone" />

        <include
            android:id="@+id/tab_terminal_view"
            layout="@layout/tab_terminal"
            android:visibility="gone" />

        <include
            android:id="@+id/tab_settings_view"
            layout="@layout/tab_settings"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_nav_island"
        android:elevation="10dp">
        <LinearLayout
            android:id="@+id/nav_item_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" android:background="@drawable/bg_nav_active">
            <ImageView
                android:id="@+id/tv_nav_icon_dashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_bolt"
                android:contentDescription="Tối ưu" />
            <TextView
                android:id="@+id/tv_nav_label_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tối ưu"
                android:textColor="#2DD4B0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_item_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/tv_nav_icon_apps"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_apps"
                android:contentDescription="Ứng dụng" />
            <TextView
                android:id="@+id/tv_nav_label_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ứng dụng"
                android:textColor="#6B7385"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_item_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/tv_nav_icon_terminal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_terminal"
                android:contentDescription="Terminal" />
            <TextView
                android:id="@+id/tv_nav_label_terminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Terminal"
                android:textColor="#6B7385"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_item_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/tv_nav_icon_settings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_settings"
                android:contentDescription="Cài đặt" />
            <TextView
                android:id="@+id/tv_nav_label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cài đặt"
                android:textColor="#6B7385"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
