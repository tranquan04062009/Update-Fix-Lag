<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_tab_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="100dp">

        <!-- VERSION & UPDATE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản ứng dụng"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_settings_version_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản 1.0.1 (Bản chính thức)"
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_settings_check_update"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Kiểm tra"
                android:textColor="#2DD4B0"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- PERFORMANCE PANEL (built in code: diagnosis + AOSP tweaks) -->
        <LinearLayout
            android:id="@+id/ll_perf_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ANIMATION SPEED SCALER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tốc độ chuyển cảnh"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tối ưu hóa thời gian phản hồi và chuyển cảnh mượt mà giữa các ứng dụng."
                android:textColor="#A3ABBB"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/pill_anim_0"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Tắt hiệu ứng"
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/pill_anim_05"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill_active"
                    android:text="0.5x (Nhanh)"
                    android:textColor="#2DD4B0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pill_anim_1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pill"
                    android:text="1.0x (Mặc định)"
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BACKGROUND LOW-RAM TUNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tối ưu hóa RAM chạy ngầm"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động thu hồi RAM và đóng băng các ứng dụng không hoạt động."
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_settings_lowram"
                style="@style/ShadcnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                android:textOn=""
                android:textOff=""
                android:switchMinWidth="48dp"
                android:thumbTextPadding="0dp"
                android:splitTrack="false"
                android:track="@drawable/switch_track"
                android:thumb="@drawable/switch_thumb" />
        </LinearLayout>

        <!-- TOUCH SENSITIVITY BOOSTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ nhạy cảm ứng &amp; Phản hồi nhanh"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tăng tốc độ quét màn hình cảm ứng và giảm độ trễ phản hồi khi chạm."
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_settings_touch"
                style="@style/ShadcnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                android:textOn=""
                android:textOff=""
                android:switchMinWidth="48dp"
                android:thumbTextPadding="0dp"
                android:splitTrack="false"
                android:track="@drawable/switch_track"
                android:thumb="@drawable/switch_thumb" />
        </LinearLayout>

        <!-- ZERO LATENCY RENDERING OPTIMIZER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tối ưu hóa khung hình &amp; Hiển thị"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loại bỏ độ trễ vẽ bề mặt và tối ưu hiệu suất mượt mà cho toàn hệ thống."
                    android:textColor="#A3ABBB"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_settings_zerolatency"
                style="@style/ShadcnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                android:textOn=""
                android:textOff=""
                android:switchMinWidth="48dp"
                android:thumbTextPadding="0dp"
                android:splitTrack="false"
                android:track="@drawable/switch_track"
                android:thumb="@drawable/switch_thumb" />
        </LinearLayout>

        <!-- WIDGET GUIDE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiện ích Màn hình chính (Widget)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhấn giữ ngoài màn hình chính → chọn Widgets → thêm Z-RAM Extreme để dọn dẹp RAM 1-chạm cực nhanh mà không cần mở ứng dụng!"
                android:textColor="#A3ABBB"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- DEVICE HARDWARE SPECS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin thiết bị"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thiết bị: Samsung Galaxy A42 5G (SM-A426N)\nBộ xử lý: Qualcomm Snapdragon 750G 5G\nHệ điều hành: Android 13\nTrạng thái bộ nhớ: Đang hoạt động tối ưu"
                android:textColor="#A3ABBB"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
