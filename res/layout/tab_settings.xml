<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_tab_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="80dp">

        <!-- VERSION & UPDATE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản ứng dụng"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_settings_version_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản 1.0.0 (Bản chính thức)"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_settings_check_update"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="Kiểm tra"
                android:textColor="#00F0FF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- AOSP ANIMATION LATENCY SCALER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tăng tốc chuyển cảnh AOSP"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rút ngắn độ trễ khung hình của Window Manager và Animator."
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/pill_anim_0"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="0.0x (Tắt)"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/pill_anim_05"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill_active"
                    android:text="0.5x (Siêu tốc)"
                    android:textColor="#00F0FF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pill_anim_1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_pill"
                    android:text="1.0x (Chuẩn)"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AOSP PHENOTYPE LOW-RAM TUNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AOSP Phenotype Low-RAM Tuner"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compaction chủ động &amp; Cgroup v2 Freezer (đóng băng ngầm sau 10s)."
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_settings_lowram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- WIDGET GUIDE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiện ích Màn hình chính (Widget)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhấn giữ ngoài màn hình chính → chọn Widgets → thêm Z-RAM Extreme để dọn dẹp RAM 1-chạm cực nhanh mà không cần mở ứng dụng!"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- DEVICE & TECHNOLOGY SPECS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thiết bị &amp; Công nghệ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_settings_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model: Samsung Galaxy A42 5G (SM-A426N)\nChipset: Qualcomm Snapdragon 750G 5G • Android 13\nNhân điều khiển: Shizuku UID 2000 &amp; Linux Kernel 4.19\nGiao diện: 100% Native Java 60fps (Không WebView)"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
