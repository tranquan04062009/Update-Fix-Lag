<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Z-RAM PURGER"
            android:textColor="#2DD4B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ram_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--% RAM"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ram_avail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khả dụng: -- MB"
            android:textColor="#A3ABBB"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_boost_btn"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/widget_btn_bg"
        android:text="⚡ BOOST"
        android:textColor="#0A0C10"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingLeft="14dp"
        android:paddingRight="14dp" />

</LinearLayout>
