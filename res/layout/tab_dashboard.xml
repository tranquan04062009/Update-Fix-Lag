<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_tab_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="80dp">

        <!-- HERO RAM GAUGE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BỘ NHỚ RAM TỔNG THỂ"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_gauge_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● TRỰC TIẾP"
                    android:textColor="#00F0FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_ram_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ram_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="Khả dụng: -- GB / -- GB"
                    android:textColor="#94A3B8"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Custom Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_ram"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_ram" />
        </LinearLayout>

        <!-- BENTO ROW 1: RAM KHẢ DỤNG & ZRAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- Card 1: RAM Khả dụng -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_card_bento">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM KHẢ DỤNG"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_avail_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- GB"
                    android:textColor="#00F0FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_used_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang dùng: -- GB"
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 2: ZRAM Stats -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_card_bento">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZRAM NÉN ĐA TẦNG"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_zram_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--x"
                    android:textColor="#A855F7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_zram_saved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiết kiệm: -- MB"
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BENTO ROW 2: HARDWARE TEMPERATURES (CPU, GPU, PIN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- Card 3: CPU & GPU Temp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_card_bento">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NHIỆT ĐỘ SOC"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cpu_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU: -- °C"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_gpu_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU: -- °C"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 4: Battery Temp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_card_bento">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NHIỆT ĐỘ PIN"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_battery_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_thermal_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng thái: Tối ưu"
                    android:textColor="#64748B"
                    android:textSize="10.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TIER INTENSITY SELECTOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_bento">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CƯỜNG ĐỘ TỐI ƯU HÓA"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/pill_tier_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Tiêu chuẩn\nKill ngầm"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pill_tier_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Thông minh\nStandby"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pill_tier_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_chip_pill_active"
                    android:text="Cực đại\nART GC"
                    android:textColor="#00F0FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRIMARY SUPER BOOST BUTTON -->
        <Button
            android:id="@+id/btn_super_boost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_boost"
            android:text="⚡ BUNG HIỆU NĂNG TỨC THÌ"
            android:textColor="#050811"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <!-- AOSP QUICK ACTIONS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_aosp_idle_maint"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="⚡ Bảo trì sâu AOSP"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_aosp_trim_caches"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="🧹 Dọn cache 2GB"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- EXTREME GAME BOOSTER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extreme Game Booster"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adreno 619 Turbo • Kryo EAS Priority"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_game_booster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Hardware Telemetry Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPU XUNG"
                        android:textColor="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_booster_gpu_clk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- MHz"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPU TẢI"
                        android:textColor="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_booster_gpu_load"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPU NHIỆT"
                        android:textColor="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_booster_gpu_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU BIG"
                        android:textColor="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_booster_cpu_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- GHz"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- AOT Target Compilation Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/et_target_game_pkg"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_pill"
                    android:hint="Gói game (vd: com.dts.freefireth)..."
                    android:textColorHint="#475569"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_trigger_aot"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="AOT SPEED"
                    android:textColor="#00F0FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Emergency Rollback Link -->
            <TextView
                android:id="@+id/tv_emergency_rollback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="↺ Khôi phục mặc định OEM (Emergency Rollback)"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:padding="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
