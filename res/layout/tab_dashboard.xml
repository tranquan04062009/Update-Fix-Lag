<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_tab_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="112dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Tối ưu"
            android:textColor="#F3F5F9"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:layout_marginTop="2dp"
            android:text="Giữ máy mượt chỉ với một chạm"
            android:textColor="#6B7385"
            android:textSize="13sp" />
        <!-- Permission banner (shown only when no Shizuku/Root) -->
        <LinearLayout
            android:id="@+id/card_permission_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            android:clickable="true"
            android:background="@drawable/bg_banner_warn">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có quyền hệ thống"
        android:textColor="#F5A524"
        android:textSize="14sp"
        android:textStyle="bold" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cấp quyền Shizuku hoặc Root để dọn RAM sâu và dùng các tinh chỉnh. Chạm để cấp quyền."
        android:textColor="#A3ABBB"
        android:textSize="12.5sp"
        android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_hero">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BỘ NHỚ RAM"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/tv_health_score"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_score_chip"
                    android:text="Đang kiểm tra…"
                    android:textColor="#2DD4B0"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
        android:id="@+id/tv_ram_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--%"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:letterSpacing="-0.02" />
            <TextView
        android:id="@+id/tv_ram_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khả dụng: -- GB / -- GB"
        android:textColor="#A3ABBB"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />
            <ProgressBar
                android:id="@+id/progress_ram"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_ram" />
        </LinearLayout>

        <!-- TIER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/pill_tier_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Nhẹ\nCache &amp; nền"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/pill_tier_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Cân bằng\nIdle &amp; Standby"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/pill_tier_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/bg_chip_pill_active"
                    android:text="Mạnh\nToàn diện"
                    android:textColor="#2DD4B0"
                    android:textSize="12sp" />
        </LinearLayout>

        <!-- PRIMARY ACTION -->
        <Button
            android:id="@+id/btn_super_boost"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_boost"
            android:stateListAnimator="@null"
            android:text="Giải phóng RAM"
            android:textAllCaps="false"
            android:textColor="#04201B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- LAST RESULT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_bento">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LẦN DỌN GẦN NHẤT"
        android:textColor="#6B7385"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
            <TextView
        android:id="@+id/tv_last_purge_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có lần dọn nào"
        android:textColor="#F3F5F9"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />
            <TextView
        android:id="@+id/tv_last_purge_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhấn “Giải phóng RAM” để bắt đầu."
        android:textColor="#A3ABBB"
        android:textSize="12.5sp"
        android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:text="TÌNH TRẠNG MÁY"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RAM KHẢ DỤNG"
        android:textColor="#6B7385"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
                <TextView
        android:id="@+id/tv_avail_ram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- GB"
        android:textColor="#2DD4B0"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />
                <TextView
        android:id="@+id/tv_used_ram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang dùng: -- GB"
        android:textColor="#A3ABBB"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NÉN ZRAM"
        android:textColor="#6B7385"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
                <TextView
        android:id="@+id/tv_zram_ratio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--x"
        android:textColor="#8B7CFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />
                <TextView
        android:id="@+id/tv_zram_saved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiết kiệm: -- MB"
        android:textColor="#A3ABBB"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHIỆT ĐỘ CPU"
        android:textColor="#6B7385"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
                <TextView
        android:id="@+id/tv_cpu_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPU: -- °C"
        android:textColor="#F3F5F9"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />
                <TextView
        android:id="@+id/tv_gpu_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPU: -- °C"
        android:textColor="#A3ABBB"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHIỆT ĐỘ PIN"
        android:textColor="#6B7385"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />
                <TextView
        android:id="@+id/tv_battery_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- °C"
        android:textColor="#34D399"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />
                <TextView
        android:id="@+id/tv_thermal_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhiệt độ: Mát mẻ"
        android:textColor="#A3ABBB"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="4dp"
            android:text="DỌN DẸP NHANH"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"><Button
                android:id="@+id/btn_aosp_idle_maint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="Tối ưu hệ thống"
                android:textAllCaps="false"
                android:textColor="#F3F5F9"
                android:textSize="13sp"
                android:textStyle="bold" /><Button
                android:id="@+id/btn_aosp_trim_caches"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="Dọn bộ nhớ đệm"
                android:textAllCaps="false"
                android:textColor="#F3F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
