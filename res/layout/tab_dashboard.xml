<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_tab_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="100dp">

        <!-- HERO: RAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card_hero">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BỘ NHỚ RAM"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <TextView
            android:id="@+id/tv_gauge_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Trực tiếp"
            android:textColor="#2DD4B0"
            android:textSize="11sp"
            android:textStyle="bold" />
            </LinearLayout>

            <TextView
            android:id="@+id/tv_ram_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:letterSpacing="-0.02" />
            <TextView
            android:id="@+id/tv_ram_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khả dụng: -- GB / -- GB"
            android:textColor="#A3ABBB"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

            <ProgressBar
                android:id="@+id/progress_ram"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_ram" />
        </LinearLayout>

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM KHẢ DỤNG"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
                <TextView
            android:id="@+id/tv_avail_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- GB"
            android:textColor="#2DD4B0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
                <TextView
            android:id="@+id/tv_used_ram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang dùng: -- GB"
            android:textColor="#A3ABBB"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NÉN ZRAM"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
                <TextView
            android:id="@+id/tv_zram_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--x"
            android:textColor="#8B7CFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
                <TextView
            android:id="@+id/tv_zram_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiết kiệm: -- MB"
            android:textColor="#A3ABBB"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NHIỆT ĐỘ CPU"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
                <TextView
            android:id="@+id/tv_cpu_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU: -- °C"
            android:textColor="#F3F5F9"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
                <TextView
            android:id="@+id/tv_gpu_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU: -- °C"
            android:textColor="#A3ABBB"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_bento">
                <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NHIỆT ĐỘ PIN"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
                <TextView
            android:id="@+id/tv_battery_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- °C"
            android:textColor="#34D399"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
                <TextView
            android:id="@+id/tv_thermal_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhiệt độ: Mát mẻ"
            android:textColor="#A3ABBB"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TIER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_bento">
            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CƯỜNG ĐỘ DỌN DẸP"
            android:textColor="#6B7385"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/pill_tier_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Nhẹ\nCache &amp; nền"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/pill_tier_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:text="Cân bằng\nIdle &amp; Standby"
                    android:textColor="#A3ABBB"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/pill_tier_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/bg_chip_pill_active"
                    android:text="Mạnh\nToàn diện"
                    android:textColor="#2DD4B0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRIMARY ACTION -->
        <Button
            android:id="@+id/btn_super_boost"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_boost"
            android:stateListAnimator="@null"
            android:text="Giải phóng RAM"
            android:textAllCaps="false"
            android:textColor="#04201B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- QUICK ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/btn_aosp_idle_maint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="Tối ưu hệ thống"
                android:textAllCaps="false"
                android:textColor="#F3F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_aosp_trim_caches"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"
                android:text="Dọn bộ nhớ đệm"
                android:textAllCaps="false"
                android:textColor="#F3F5F9"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- GAME BOOSTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_bento">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Booster"
            android:textColor="#F3F5F9"
            android:textSize="16sp"
            android:textStyle="bold" />
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ưu tiên GPU và hiệu năng đồ họa"
            android:textColor="#6B7385"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_game_booster"
                    style="@style/ShadcnSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    android:textOn=""
                    android:textOff=""
                    android:switchMinWidth="52dp"
                    android:thumbTextPadding="0dp"
                    android:splitTrack="false"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU XUNG"
            android:textColor="#6B7385"
            android:textSize="10.5sp"
            android:textStyle="bold" />
                    <TextView
            android:id="@+id/tv_booster_gpu_clk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- MHz"
            android:textColor="#F3F5F9"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU TẢI"
            android:textColor="#6B7385"
            android:textSize="10.5sp"
            android:textStyle="bold" />
                    <TextView
            android:id="@+id/tv_booster_gpu_load"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- %"
            android:textColor="#F3F5F9"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPU NHIỆT"
            android:textColor="#6B7385"
            android:textSize="10.5sp"
            android:textStyle="bold" />
                    <TextView
            android:id="@+id/tv_booster_gpu_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- °C"
            android:textColor="#F3F5F9"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_pill">
                    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU LÕI LỚN"
            android:textColor="#6B7385"
            android:textSize="10.5sp"
            android:textStyle="bold" />
                    <TextView
            android:id="@+id/tv_booster_cpu_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- GHz"
            android:textColor="#F3F5F9"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compile target -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">
                <EditText
                    android:id="@+id/et_target_game_pkg"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_pill"
                    android:hint="Gói game / ứng dụng"
                    android:textColorHint="#5A6275"
                    android:textColor="#F3F5F9"
                    android:textSize="12sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />
                <Button
                    android:id="@+id/btn_pick_game_pkg"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_pill"
                    android:stateListAnimator="@null"
                    android:text="Chọn game"
                    android:textAllCaps="false"
                    android:textColor="#F3F5F9"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
                <Button
                    android:id="@+id/btn_trigger_aot"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="Tăng tốc"
                    android:textAllCaps="false"
                    android:textColor="#2DD4B0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>

            <!-- GAMEMANAGERSERVICE RESOLUTION & FPS CONTROLS -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1F2430"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ĐỘ PHÂN GIẢI (GAMEMANAGERSERVICE)"
                    android:textColor="#6B7385"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
                <TextView
                    android:id="@+id/tv_game_resolution_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AOSP NATIVE"
                    android:textColor="#2DD4B0"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_shizuku" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tùy chỉnh tỷ lệ render nội bộ của game qua GameManagerService để giảm tải GPU, tăng khung hình mượt mà."
                android:textColor="#A3ABBB"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <!-- Row: Select Resolution & Select FPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỶ LỆ PHÂN GIẢI"
                        android:textColor="#6B7385"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btn_select_resolution"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_chip_pill"
                        android:stateListAnimator="@null"
                        android:text="80% (Khuyên dùng) ▼"
                        android:textAllCaps="false"
                        android:textColor="#F3F5F9"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KHUNG HÌNH (FPS)"
                        android:textColor="#6B7385"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btn_select_fps"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_chip_pill"
                        android:stateListAnimator="@null"
                        android:text="120 FPS ▼"
                        android:textAllCaps="false"
                        android:textColor="#F3F5F9"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row: Apply Resolution & Reset to Default -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_apply_game_resolution"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"
                    android:text="Áp dụng phân giải"
                    android:textAllCaps="false"
                    android:textColor="#2DD4B0"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_reset_game_resolution"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_pill"
                    android:stateListAnimator="@null"
                    android:text="Về mặc định (100%)"
                    android:textAllCaps="false"
                    android:textColor="#FF8080"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Indicator -->
            <TextView
                android:id="@+id/tv_game_resolution_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:text="Chưa can thiệp — Độ phân giải gốc 100%"
                android:textColor="#6B7385"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tv_emergency_rollback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Khôi phục cài đặt mặc định"
                android:textColor="#6B7385"
                android:textSize="12sp"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
