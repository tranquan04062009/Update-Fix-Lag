<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_tab_apps"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Ứng dụng"
            android:textColor="#F3F5F9"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:layout_marginTop="2dp"
            android:text="Chọn app được giữ lại khi dọn RAM"
            android:textColor="#6B7385"
            android:textSize="13sp" />
    <ImageView
        android:id="@+id/ic_apps_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/ic_search"
        android:contentDescription="Tìm kiếm" />

    <EditText
        android:id="@+id/et_search_apps"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="#6B7385"
        android:hint="Tìm tên ứng dụng hoặc package"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#F3F5F9"
        android:textColorHint="#5A6275"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/chip_apps_all"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_chip_pill_active"
            android:text="Tất cả"
            android:textColor="#2DD4B0"
            android:textSize="12.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/chip_apps_kept"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_chip_pill"
            android:text="Đã giữ lại"
            android:textColor="#A3ABBB"
            android:textSize="12.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_apps_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text=""
            android:textColor="#6B7385"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">
        <ListView
            android:id="@+id/lv_installed_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="#00000000"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="104dp"
            android:scrollbars="none" />
        <ProgressBar
            android:id="@+id/pb_apps_loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2DD4B0"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tv_apps_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không tìm thấy ứng dụng phù hợp"
            android:textColor="#6B7385"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
