<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_tab_terminal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="80dp">

    <!-- Quick Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_cmd_idlemaint"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="idle-maint"
                android:textColor="#00F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_cmd_trimcaches"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="trim-caches"
                android:textColor="#00F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_cmd_hibernation"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="hibernation"
                android:textColor="#00F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_cmd_game"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="game mode"
                android:textColor="#00F0FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_cmd_free"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="free -m"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_cmd_meminfo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="meminfo"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Terminal Viewport -->
    <ScrollView
        android:id="@+id/scroll_terminal_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_bento"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textColor="#00F0FF"
            android:textSize="11.5sp"
            android:lineSpacingExtra="3dp"
            android:text="-- BẢNG ĐIỀU KHIỂN SHELL ADB / SHIZUKU --\nSẵn sàng thực thi lệnh trực tiếp..." />
    </ScrollView>

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/et_terminal_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_bento"
            android:hint="Nhập lệnh shell (vd: free -m)..."
            android:textColorHint="#475569"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_terminal_exec"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_boost"
            android:text="CHẠY"
            android:textColor="#050811"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
