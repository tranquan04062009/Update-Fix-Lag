<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0F172A"
                android:centerColor="#07090E"
                android:endColor="#0284C7" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item android:gravity="center" android:width="48dp" android:height="48dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#00F0FF"
                android:endColor="#A855F7" />
        </shape>
    </item>
</layer-list>
